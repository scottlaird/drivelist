# systemd unit for the drivelist agent. Install with:
#   cp contrib/drivelist-agent.service /etc/systemd/system/
#   install -m 600 agent-token /etc/drivelist/agent-token   (or set the env below)
#   systemctl enable --now drivelist-agent
[Unit]
Description=drivelist fleet agent
After=network-online.target zfs.target
Wants=network-online.target

[Service]
Type=simple
# Server and agent token; a file with KEY=value lines, mode 600.
EnvironmentFile=/etc/drivelist/agent.env
# Creates /var/lib/drivelist for the spool and status cache.
StateDirectory=drivelist
ExecStart=/usr/local/bin/drivelist agent --state-dir /var/lib/drivelist
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
